// Prisma schema for Eisenhower Todo App
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]
  customers     Customer[]
  teamMembers   TeamMember[]
  tags          Tag[]
  tasks         Task[]
  taskEvents    TaskEvent[]
  userSettings  UserSettings?
  apiKeys       ApiKey[]
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  name      String   @db.VarChar(100)
  keyHash   String   @unique @db.VarChar(64)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  workHours       Json?    // { mon: { start: "08:00", end: "16:00" }, tue: ..., sun: ... }
  priorityFactors Json?   // { typeImportance: { kunde, salg, ledelse, internt }, typeUrgency: {...}, customerMultiplier }
  visualCue       Json?    // { enabled, colors: { kunde, internt, salg, ledelse } } — venstre streg på opgaver
  tableColumns    Json?    // { order: [...], enabled: { ... } } — tabeloversigt kolonner/rækkefølge
  timeTracking    Json?    // { url, apiKey, userId } — ekstern tidsregistrering
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
}

model Customer {
  id       String  @id @default(cuid())
  userId   String
  name     String
  code     String? @db.VarChar(3)
  priority Int     @default(5) // 0-10, bruges til importance/urgency når ingen deadline

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
  @@unique([userId, code])
}

model TeamMember {
  id     String  @id @default(cuid())
  userId String
  name   String
  code   String? @db.VarChar(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
  @@unique([userId, code])
}

model Tag {
  id           String   @id @default(cuid())
  userId       String
  name         String
  color        String   @db.VarChar(7)
  isBlacklisted Boolean @default(false)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTags TaskTag[]

  @@index([userId])
  @@unique([userId, name])
}

enum TaskStatus {
  inbox_raw
  needs_clarification
  qualified
  done
  snoozed
  udvikling
}

enum DurationBucket {
  LT15
  M15_30
  M30_60
  GT60
}

enum TaskType {
  kunde
  internt
  salg
  ledelse
}

enum LinkedEventType {
  prep
  followup
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  status      TaskStatus   @default(inbox_raw)

  title       String       @db.Text
  notes       String?      @db.Text

  durationBucket DurationBucket?
  type          TaskType?
  customerId    String?
  canDelegate   Boolean     @default(false)
  delegatedToId String?

  importance   Int?        // 0-100
  urgency      Int?        // 0-100
  nextAction   String?     @db.Text

  /** AI parse status: pending=venter, parsing=kører, parsed=klar, failed=fejlede */
  parseStatus  String?     @db.VarChar(20)

  dueAt        DateTime?

  url          String?     @db.Text
  tag          String?

  linkedEventId    String?
  linkedEventType  LinkedEventType?
  linkedEventTitle String?       @db.Text
  linkedEventUrl   String?       @db.Text
  eventStartAt     DateTime?
  eventEndAt       DateTime?

  recurrenceRule   String?       @db.VarChar(100)  // "DAILY" | "WEEKLY" | "MONTHLY"

  importanceManuallyOverriddenAt  DateTime?  // Når sat: AI må aldrig overskrive importance
  urgencyManuallyOverriddenAt    DateTime?  // Når sat: AI må aldrig overskrive urgency (deadline kan stadig)
  lockOverride                  Boolean   @default(false) // Ignorér lås-advarsel fra dependencies

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  delegatedTo TeamMember? @relation(fields: [delegatedToId], references: [id], onDelete: SetNull)
  events     TaskEvent[]
  taskTags   TaskTag[]
  dependencies TaskDependency[] @relation("TaskDependency_task")
  dependents   TaskDependency[] @relation("TaskDependency_dependsOn")

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueAt])
}

model TaskDependency {
  taskId          String
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task         Task @relation("TaskDependency_task", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependency_dependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
}

enum TaskEventType {
  created
  parsed
  ai_scored
  overridden
  qualified
  done
  snoozed
}

model TaskEvent {
  id        String        @id @default(cuid())
  taskId    String
  userId    String
  eventType TaskEventType
  payload   Json?
  createdAt DateTime      @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}
