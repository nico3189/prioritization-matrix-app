# Copy to .env and fill in. Never commit .env.
# Lokal Postgres (Homebrew) – erstat USER med dit macOS-brugernavn (whoami)
DATABASE_URL="postgresql://USER@localhost:5432/prioritization_matrix"

# Første gang: npm run db:setup-local
# Derefter: LIVE_DATABASE_URL="postgresql://..." npm run db:sync-from-live

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
OPENAI_API_KEY=""
# Optional: secret for hourly cron that syncs urgency (set in Heroku for Scheduler)
CRON_SECRET=""
